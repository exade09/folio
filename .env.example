# Server-only. Never prefix any of these with NEXT_PUBLIC_ — that compiles the
# value into the JavaScript every visitor downloads.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Helius RPC key. When set, the server reads the chain through
# https://mainnet.helius-rpc.com/?api-key=<this>. Without it, SOLANA_RPC_URL
# below is used, then the public endpoint.
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# The browser never reads the chain (Folio sends no transactions), so this
# stays the public endpoint. Do not put the Helius URL here.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Postgres for the case store. The Neon integration on Vercel sets this for
# the project; locally, `vercel env pull .env.local` copies it down. Leave it
# empty to keep cases as JSON files under data/cases instead.
DATABASE_URL=

# Not wired in yet: Birdeye, for the facts Helius does not cover.
# BIRDEYE_API_KEY=
